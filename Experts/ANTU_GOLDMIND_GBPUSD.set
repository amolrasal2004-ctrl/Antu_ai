; === License & Security ===
InpPassword=ANTU2024PRO
InpLicenseKey=
InpTrialDays=7
InpAdminPassword=

; === Money Management ===
InpUseRiskPercent=true
InpRiskPercent=0.8
InpFixedLotSize=0.01
InpMaxLotCap=0.50
InpMaxSLDollar=3.0

; === Stop Loss / Take Profit ===
InpUseATRStops=true
InpATRMultSL=1.2
InpATRMultTP=3.5
