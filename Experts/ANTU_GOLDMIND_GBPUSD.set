InpFixedTPPips=25.0

; === Trailing & Breakeven ===
InpUseBreakeven=true
InpBEActivatePips=6.0
InpBEOffsetPips=1.5
InpUseTrailing=true
InpTrailStartPips=8.0
InpTrailStepPips=4.0

; === Partial Close (Profit Booster) ===
InpUsePartialClose=true
InpPartialPercent=50.0
InpPartialTPRatio=0.5

; === Daily Guard ===
InpUsePercentGuard=true
InpDailyTargetPct=4.0
InpDailyMaxLossPct=4.0
InpDailyTargetUSD=25.0
InpDailyMaxLossUSD=12.0
InpMaxConsecutiveLoss=3
InpMaxTradesPerDay=10

; === Quality Filters ===
InpMinBandDistancePips=25.0
InpMaxSpread=20
InpMinATRPips=4.0
InpMaxATRPips=40.0
