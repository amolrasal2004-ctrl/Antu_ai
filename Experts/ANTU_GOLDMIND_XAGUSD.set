InpFixedTPPips=25.0

; === Trailing & Breakeven ===
InpUseBreakeven=true
InpBEActivatePips=6.0
InpBEOffsetPips=2.0
InpUseTrailing=true
InpTrailStartPips=8.0
InpTrailStepPips=4.0

; === Partial Close (Profit Booster) ===
InpUsePartialClose=true
InpPartialPercent=50.0
InpPartialTPRatio=0.5

; === Daily Guard ===
InpUsePercentGuard=true
InpDailyTargetPct=5.0
InpDailyMaxLossPct=5.0
InpDailyTargetUSD=30.0
InpDailyMaxLossUSD=15.0
InpMaxConsecutiveLoss=3
